                {expandedYears.has('2015') && <>
                <li className="relative pl-6 p-2 rounded hover:border-l-4 hover:border-red-500 transition-all duration-200"><span className="absolute left-2 top-2 text-red-600 font-bold text-base">•</span>KC Santosh, S Candemir, S Jaeger, S Antani, G Thoma, L Folio: <span className="text-gray-800">Automatically Detecting Rotation in Chest Radiographs using Principal Rib-Orientation Measure for Quality Control</span>, <strong className="text-blue-700">International Journal of Pattern Recognition &amp; Artificial Intelligence</strong>, <span className="text-orange-600">World Scientific</span> <span className="text-green-700">(2015)</span>. <a href="https://doi.org/10.1142/S021800141550025X" target="_blank" rel="noopener noreferrer" className="bg-green-100 text-green-700 px-1 py-0.5 rounded text-xs underline">DOI</a></li>
                <li className="relative pl-6 p-2 rounded hover:border-l-4 hover:border-red-500 transition-all duration-200"><span className="absolute left-2 top-2 text-red-600 font-bold text-base">•</span>KC Santosh, L Wendling: <span className="text-gray-800">Graphical Symbol Recognition</span>, <strong className="text-blue-700">Wiley Encyclopedia of Electrical and Electronics Engineering</strong> <span className="text-green-700">(2015)</span>. <a href="https://doi.org/10.1002/047134608X.W8360" target="_blank" rel="noopener noreferrer" className="bg-green-100 text-green-700 px-1 py-0.5 rounded text-xs underline">DOI</a></li>
                <li className="relative pl-6 p-2 rounded hover:border-l-4 hover:border-red-500 transition-all duration-200"><span className="absolute left-2 top-2 text-red-600 font-bold text-base">•</span>KC Santosh, L Wendling: <span className="text-gray-800">Character recognition based on Multi-projection Non-linear Profiles Measure</span>, <strong className="text-blue-700">Frontiers of Computer Science</strong>, <span className="text-orange-600">Springer</span> <span className="text-green-700">(2015)</span>. <a href="https://doi.org/10.1007/s11704-014-3213-8" target="_blank" rel="noopener noreferrer" className="bg-green-100 text-green-700 px-1 py-0.5 rounded text-xs underline">DOI</a></li>
                <li className="relative pl-6 p-2 rounded hover:border-l-4 hover:border-red-500 transition-all duration-200"><span className="absolute left-2 top-2 text-red-600 font-bold text-base">•</span>S Candemir, E Borovikov, KC Santosh, S Antani, G Thoma: <span className="text-gray-800">RSILC: Rotation and Scale Invariant, Line Colour aware Descriptor</span>, <strong className="text-blue-700">Image and Vision Computing</strong> <span className="text-green-700">(2015)</span>. <a href="https://doi.org/10.1016/j.imavis.2014.10.012" target="_blank" rel="noopener noreferrer" className="bg-green-100 text-green-700 px-1 py-0.5 rounded text-xs underline">DOI</a></li>
                <li className="relative pl-6 p-2 rounded hover:border-l-4 hover:border-red-500 transition-all duration-200"><span className="absolute left-2 top-2 text-red-600 font-bold text-base">•</span>E Philippot, KC Santosh, A Belaïd, Y Belaïd: <span className="text-gray-800">Bayesian Networks for Incomplete Data Analysis in Form Processing</span>, <strong className="text-blue-700">International Journal of Machine Learning &amp; Cybernetics</strong>, <span className="text-orange-600">Springer</span> <span className="text-green-700">(2015)</span>. <a href="https://doi.org/10.1007/s13042-015-0342-9" target="_blank" rel="noopener noreferrer" className="bg-green-100 text-green-700 px-1 py-0.5 rounded text-xs underline">DOI</a></li>
                <li className="pl-6 p-2 text-xs text-gray-500 italic">Conference proceedings: ImageCLEF (1), IEEE CBMS (2)</li>
                </>}

                {/* 2005–2014 */}
                <li className="mt-2">
                  <button onClick={() => toggleYear('2005–2014')} className="w-full flex items-center gap-2 px-3 py-2 rounded-lg bg-red-50 hover:bg-red-100 transition-colors duration-150 text-left">
                    <span className={`text-red-500 transition-transform duration-200 ${expandedYears.has('2005–2014') ? 'rotate-90' : ''}`}>▶</span>
                    <strong className="text-logo-red text-base">2005–2014</strong>
                    <span className="text-gray-500 text-xs ml-1">— 8 journal articles, 1 book chapter and conference proceedings (by year)</span>
                  </button>
                </li>
                {expandedYears.has('2005–2014') && <>
                <li className="relative pl-6 p-2 rounded hover:border-l-4 hover:border-red-500 transition-all duration-200"><span className="absolute left-2 top-2 text-red-600 font-bold text-base">•</span>KC Santosh, L Wendling, B Lamiroy: <span className="text-gray-800">BoR: Bags-of-Relations for Symbol Retrieval</span>, <strong className="text-blue-700">International Journal of Pattern Recognition and Artificial Intelligence</strong>, <span className="text-orange-600">World Scientific</span> <span className="text-green-700">(2014)</span>. <a href="https://doi.org/10.1142/S021800141450021X" target="_blank" rel="noopener noreferrer" className="bg-green-100 text-green-700 px-1 py-0.5 rounded text-xs underline">DOI</a></li>
                <li className="relative pl-6 p-2 rounded hover:border-l-4 hover:border-red-500 transition-all duration-200"><span className="absolute left-2 top-2 text-red-600 font-bold text-base">•</span>KC Santosh, B Lamiroy, L Wendling: <span className="text-gray-800">Integrating Vocabulary Clustering with Spatial Relations for Symbol Recognition</span>, <strong className="text-blue-700">International Journal of Document Analysis and Recognition</strong>, <span className="text-orange-600">Springer</span> <span className="text-green-700">(2014)</span>. <a href="https://doi.org/10.1007/s10032-013-0212-7" target="_blank" rel="noopener noreferrer" className="bg-green-100 text-green-700 px-1 py-0.5 rounded text-xs underline">DOI</a></li>
                <li className="relative pl-6 p-2 rounded hover:border-l-4 hover:border-red-500 transition-all duration-200"><span className="absolute left-2 top-2 text-red-600 font-bold text-base">•</span>KC Santosh, L Wendling, B Lamiroy: <span className="text-gray-800">DTW–Radon Shape Descriptor for Pattern Recognition</span>, <strong className="text-blue-700">International Journal of Pattern Recognition and Artificial Intelligence</strong>, <span className="text-orange-600">World Scientific</span> <span className="text-green-700">(2013)</span>. <a href="https://doi.org/10.1142/S0218001413560137" target="_blank" rel="noopener noreferrer" className="bg-green-100 text-green-700 px-1 py-0.5 rounded text-xs underline">DOI</a></li>
                <li className="relative pl-6 p-2 rounded hover:border-l-4 hover:border-red-500 transition-all duration-200"><span className="absolute left-2 top-2 text-red-600 font-bold text-base">•</span>KC Santosh, C Nattee, B Lamiroy: <span className="text-gray-800">Relative Positioning of Stroke Based Clustering: A New Approach to On-line Handwritten Devanagari Character Recognition</span>, <strong className="text-blue-700">International Journal of Image &amp; Graphics</strong>, <span className="text-orange-600">World Scientific</span> <span className="text-green-700">(2012)</span>. <a href="https://doi.org/10.1142/S0219467812500204" target="_blank" rel="noopener noreferrer" className="bg-green-100 text-green-700 px-1 py-0.5 rounded text-xs underline">DOI</a></li>
                <li className="relative pl-6 p-2 rounded hover:border-l-4 hover:border-red-500 transition-all duration-200"><span className="absolute left-2 top-2 text-red-600 font-bold text-base">•</span>KC Santosh, B Lamiroy, L Wendling: <span className="text-gray-800">Symbol Recognition using Spatial Relations</span>, <strong className="text-blue-700">Pattern Recognition Letters</strong>, <span className="text-orange-600">Elsevier</span> <span className="text-green-700">(2012)</span>. <a href="https://doi.org/10.1016/j.patrec.2011.11.022" target="_blank" rel="noopener noreferrer" className="bg-green-100 text-green-700 px-1 py-0.5 rounded text-xs underline">DOI</a></li>
                <li className="relative pl-6 p-2 rounded hover:border-l-4 hover:border-red-500 transition-all duration-200"><span className="absolute left-2 top-2 text-red-600 font-bold text-base">•</span>KC Santosh: <span className="text-gray-800">Use of Dynamic Time Warping (DTW) for Object Shape Classification</span>, <strong className="text-blue-700">Kathmandu University Journal of Science, Engineering and Technology</strong> <span className="text-green-700">(2010)</span>. <a href="http://www.ku.edu.np/kuset/vol6_no2/KUSET_6_2.pdf" target="_blank" rel="noopener noreferrer" className="bg-blue-100 text-blue-700 px-1 py-0.5 rounded text-xs underline">Link</a></li>
                <li className="relative pl-6 p-2 rounded hover:border-l-4 hover:border-red-500 transition-all duration-200"><span className="absolute left-2 top-2 text-red-600 font-bold text-base">•</span>KC Santosh, C Nattee: <span className="text-gray-800">A Comprehensive Survey on On-line Handwriting Recognition Technology and its Real Application to the Nepalese Natural Handwriting</span>, <strong className="text-blue-700">Kathmandu University Journal of Science, Engineering and Technology</strong> <span className="text-green-700">(2009)</span>. <a href="http://www.ku.edu.np/kuset/vol5_no1/12_santosh.pdf" target="_blank" rel="noopener noreferrer" className="bg-blue-100 text-blue-700 px-1 py-0.5 rounded text-xs underline">Link</a></li>
                <li className="relative pl-6 p-2 rounded hover:border-l-4 hover:border-red-500 transition-all duration-200"><span className="absolute left-2 top-2 text-red-600 font-bold text-base">•</span>KC Santosh, C Nattee: <span className="text-gray-800">Template-based Nepali Handwritten Alphanumeric Character Recognition</span>, <strong className="text-blue-700">Thammasat International Journal of Science and Technology</strong> <span className="text-green-700">(2009)</span>. <a href="https://thammasatpress.tu.ac.th/journal/index.php/ijst" target="_blank" rel="noopener noreferrer" className="bg-blue-100 text-blue-700 px-1 py-0.5 rounded text-xs underline">Link</a></li>
                <li className="pl-6 p-2 text-xs text-gray-500 italic">Conference proceedings (by year): 2014 — ICPR (1), CBMS (1), ICFHR (1), RAIT (1) | 2013 — ICDAR (3), MVA (2), IbPRIA (1) | 2012 — GREC (1) | 2011 — IEEE ICFHR (1), IEEE ICPR (1), GREC (1) | 2009 — IEEE ICDAR (1), ACIVS (1), GREC (1) | 2006 — KICSS (1, best paper), PRICAI (1), IEEE CIS (1). Book chapters: 2012 — INTECH (1)</li>
                </>}

              </ul>
            </div>
          </div>
        </div>

        {/* Research Papers Section */}
        <div className="w-full mb-12">
          <h2 className="text-2xl md:text-3xl lg:text-4xl font-thin text-logo-red mb-6">
            Research Papers
          </h2>

          {/* Search */}
          <div className="mb-4">
            <input
              type="text"
              placeholder="Search by title, author, or keyword..."
              value={searchQuery}
              onChange={e => setSearchQuery(e.target.value)}
              className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-300 text-sm"
            />
          </div>

          {/* Category filters */}
          <div className="flex flex-wrap gap-2 mb-6">
            {categories.map(cat => (
              <button
                key={cat}
                onClick={() => setSelectedCategory(cat)}
                className={`px-3 py-1 rounded-full text-xs font-medium transition-colors duration-150 ${
                  selectedCategory === cat
                    ? 'bg-logo-red text-white'
                    : 'bg-gray-100 text-gray-600 hover:bg-red-100 hover:text-red-700'
                }`}
              >
                {cat}
              </button>
            ))}
          </div>

          {/* Results count */}
          <p className="text-xs text-gray-500 mb-4">
            Showing {startIndex + 1}–{Math.min(startIndex + itemsPerPage, filteredPublications.length)} of {filteredPublications.length} papers
          </p>

          {/* Cards */}
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            {paginatedPublications.map((pub, idx) => (
              <div
                key={idx}
                className="relative bg-white border border-gray-200 rounded-xl p-5 hover:shadow-lg transition-all duration-200 cursor-default flex flex-col"
                onMouseEnter={() => handleMouseEnter(idx)}
                onMouseLeave={handleMouseLeave}
              >
                <div className="flex items-start justify-between gap-2 mb-2">
                  <h3 className="font-bold text-gray-900 text-base leading-snug">{pub.title}</h3>
                  <span className="text-gray-400 text-lg flex-shrink-0">{hoveredPublication === idx ? '∧' : '∨'}</span>
                </div>
                {pub.authors && (
                  <p className="text-sm text-gray-500 mb-1">{pub.authors}</p>
                )}
                <p className="text-sm text-gray-400 mb-3">
                  {pub.year}{pub.venue ? ` • ${pub.venue}` : ''}
                </p>
                {hoveredPublication === idx ? (
                  <>
                    <div className="border-t border-gray-200 pt-3 mt-1">
                      <p className="text-sm font-bold text-gray-800 mb-1">Abstract:</p>
                      <p className="text-sm text-gray-600 leading-relaxed mb-4">{pub.description}</p>
                    </div>
                    {pub.paperUrl && pub.paperUrl !== '#' && (
                      <a
                        href={pub.paperUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        className="inline-flex items-center gap-2 mt-auto bg-logo-red text-white text-sm font-medium px-4 py-2 rounded-lg hover:bg-red-700 transition-colors w-fit"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" className="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                        Read Paper
                      </a>
                    )}
                  </>
                ) : (
                  <p className="text-sm text-gray-400 italic mt-auto">Hover to read more...</p>
                )}
              </div>
            ))}
          </div>

          {/* Pagination */}
          {totalPages > 1 && (
            <div className="flex items-center gap-2 mt-6 flex-wrap">
              <button
                onClick={() => setCurrentPage(p => Math.max(1, p - 1))}
                disabled={currentPage === 1}
                className="px-3 py-1 text-xs rounded border border-gray-300 disabled:opacity-40 hover:bg-gray-100"
              >
                Previous
              </button>
              {Array.from({ length: totalPages }, (_, i) => i + 1).map(page => (
                <button
                  key={page}
                  onClick={() => setCurrentPage(page)}
                  className={`px-3 py-1 text-xs rounded border transition-colors ${
                    currentPage === page
                      ? 'bg-logo-red text-white border-logo-red'
                      : 'border-gray-300 hover:bg-gray-100'
                  }`}
                >
                  {page}
                </button>
              ))}
              <button
                onClick={() => setCurrentPage(p => Math.min(totalPages, p + 1))}
                disabled={currentPage === totalPages}
                className="px-3 py-1 text-xs rounded border border-gray-300 disabled:opacity-40 hover:bg-gray-100"
              >
                Next
              </button>
            </div>
          )}
        </div>

      </div>
    </div>
    <FloatingScrollArrows />
  </PageLayout>
  );
};

export default Publications;
