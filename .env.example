# Environment Variables for LinkedIn Integration
# Add these to your .env file

# RapidAPI Key for LinkedIn scraping services
REACT_APP_RAPIDAPI_KEY=your_rapidapi_key_here

# ScrapingBee API Key (alternative)
REACT_APP_SCRAPINGBEE_KEY=your_scrapingbee_key_here

# Your backend API endpoint
REACT_APP_API_BASE_URL=https://your-backend.vercel.app

# LinkedIn Company URL
REACT_APP_LINKEDIN_COMPANY_URL=https://www.linkedin.com/company/kc-ai/posts/?feedView=all

# Firebase Configuration (Create your own Firebase project)
# Go to https://console.firebase.google.com/ to create a project
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
